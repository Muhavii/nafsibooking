@inject nafsibooking.Services.IUserAuthService Auth
@inject nafsibooking.Services.IUserService Users
@inject nafsibooking.Services.IAdminAuthService AdminAuth
@{
    nafsibooking.Models.User? currentUser = null;
    var isAdmin = AdminAuth.IsAdminAuthenticated(Context);
    var isUserAuth = Auth.IsAuthenticated(Context);
    if (isUserAuth)
    {
        var uid = Auth.GetUserId(Context);
        System.Diagnostics.Debug.WriteLine($"[Layout] User ID from cookie: {uid}");
        if (!string.IsNullOrEmpty(uid))
        {
            currentUser = Users.GetById(uid!);
            System.Diagnostics.Debug.WriteLine($"[Layout] User found: {currentUser?.DisplayName}");
        }
    }
    System.Diagnostics.Debug.WriteLine($"[Layout] isUserAuth={isUserAuth}, isAdmin={isAdmin}, currentUser={currentUser?.DisplayName}");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nafsi Booking</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/nafsibooking.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-area="" asp-page="/Index">Nafsi Booking</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index" asp-fragment="events">Events</a>
                        </li>
                    </ul>
                    @if (currentUser == null)
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Account/Login">Log In</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Account/Register">Sign Up</a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @currentUser.DisplayName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    @if (isAdmin)
                                    {
                                        <li class="px-3 text-muted small">Admin</li>
                                        <li>
                                            <a class="dropdown-item" asp-page="/Admin/Events/Create">+ Create Event</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-page="/Admin/Dashboard">Dashboard</a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                    }
                                    <li>
                                        <a class="dropdown-item" asp-page="/Account/Login">Switch Account</a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form method="post" asp-page="/Account/Logout" class="px-3">
                                            <button type="submit" class="btn btn-link dropdown-item">Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                        @if (isAdmin)
                        {
                            <!-- Optional quick admin buttons next to user dropdown -->
                            <ul class="navbar-nav ms-2">
                                <li class="nav-item">
                                    <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Events/Create">+ Create</a>
                                </li>
                                <li class="nav-item ms-2">
                                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Dashboard">Dashboard</a>
                                </li>
                            </ul>
                        }
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>&copy; 2026 - Nafsi Booking</span>
            <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
